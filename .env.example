# Copy ไฟล์นี้เป็น .env แล้วแก้ค่า

# Port (Render/Railway จะ set ให้อัตโนมัติ)
PORT=3000

# Admin password — เปลี่ยนให้ปลอดภัยก่อน deploy จริง
ADMIN_PASSWORD=admin123

# Supabase / PostgreSQL connection string
# หาได้ที่ Supabase → Project Settings → Database → Connection string → URI
# เปลี่ยน [YOUR-PASSWORD] เป็นรหัสผ่าน DB ของคุณ
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
